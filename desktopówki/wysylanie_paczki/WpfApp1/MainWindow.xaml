<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Nadaj paczkę. PESEL: 000000000" Height="450" Width="800">
    <StackPanel Orientation="Vertical" Margin="10">
        <StackPanel Orientation="Horizontal" Height="350">
            <StackPanel Width="400" Margin="0, 20, 0, 0">
                <GroupBox Height="150" Header="Rodzaj przesyłki" Width="200">
                    <StackPanel>
                        <RadioButton x:Name="Pocztowka" GroupName="TypPrzesylki" Content="Pocztówka" Margin="5" IsChecked="True"/>
                        <RadioButton x:Name="List" GroupName="TypPrzesylki" Content="List" Margin="5" />
                        <RadioButton x:Name="Paczka" GroupName="TypPrzesylki" Content="Paczka" Margin="5" />
                    </StackPanel>
                </GroupBox>
                <Button x:Name="SprawdzCeneButton" Content="Sprawdź cenę" Margin="100, 20, 100, 20" Click="Check_Radio"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image x:Name="Obrazek" Height="100" Width="100" Source="/src/list.png" Margin="0,0,10,0"/>
                    <Label x:Name="CenaLabel" Content="Cena: 1,5 zł" FontSize="20" FontWeight="Bold"/>
                </StackPanel>


            </StackPanel>
            <StackPanel Width="400">
                <GroupBox Header="Dane adresowe">
                    <StackPanel Orientation="Vertical">
                        <Label Content="Ulica z numerem" Margin="10,10,0,0"/>
                        <TextBox x:Name="Adres" Width="200" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <Label Content="Kod pocztowy" Margin="10,10,0,0"/>
                        <TextBox x:Name="kod" Width="100" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <Label Content="Miasto" Margin="10,10,0,0"/>
                        <TextBox x:Name="Miasto" Width="200" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </StackPanel>
        <Button x:Name="ZatwierdzButton" Content="Zatwierdź" Width="600" Height="30" HorizontalAlignment="Center" Margin="0,20,0,0" Click="Check_Kod"/>
    </StackPanel>

</Window>
