<Window x:Class="szyfr_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szyfr_desktop"
        mc:Ignorable="d"
        Background="CadetBlue"
        Title="Szyfrowanie. Wykonane przez: 000000000" Height="450" Width="800">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="center">
        <StackPanel Orientation="Vertical" Width="300" Margin="20">
            <TextBlock Foreground="AntiqueWhite" FontSize="20">Podaj wartość klucza</TextBlock>
            <TextBox x:Name="KeyInput" Width="50" Margin="30"></TextBox>

            <TextBlock Foreground="AntiqueWhite" FontSize="20" Margin="0,0,0,20" >Podaj tekst</TextBlock>
            <TextBox x:Name="TextInput" AcceptsReturn="True" TextWrapping="Wrap" Width="250" Height="200"></TextBox>

        </StackPanel>
        <StackPanel Orientation="Vertical" Width="100" Margin="20" VerticalAlignment="Center">
            <Button x:Name="EncodeBtn" Background="LightBlue" Width="70" Height="30" Click="EncodeAndDisplay">Zaszyfruj</Button>
        </StackPanel>
        <StackPanel Orientation="Vertical" Width="300" Margin="20">
            <TextBlock Foreground="AntiqueWhite" FontSize="20" Margin="0,0,0,20">Tekst zaszyfrowany</TextBlock>
            <Border BorderBrush="AntiqueWhite" BorderThickness="5" Height="200" Width="250" CornerRadius="10">
                <TextBlock x:Name="TextOutput" Foreground="AliceBlue" FontSize="20"></TextBlock>
            </Border>
            <Button x:Name="SaveBtn" Background="LightBlue" Margin="0,20,0,0" Width="150" Click="SaveText">Zapisz szyfr w pliku</Button>
        </StackPanel>
    </StackPanel>
</Window>
