<Window x:Class="szpont_done_right.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szpont_done_right"
        mc:Ignorable="d"
        Background="Cornsilk"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
        <StackPanel Orientation="Horizontal">
            <GroupBox Header="Dane klienta" Width="350"  Margin="5,0,0,0">
                <StackPanel Margin="10" HorizontalAlignment="Center" Width="200">
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Label Width="70">Imię</Label>
                        <TextBox x:Name="NameInput" MinWidth="100"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Label Width="70">Nazwisko</Label>
                        <TextBox x:Name="SurnameInput" MinWidth="100"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Label Width="70">Telefon</Label>
                        <TextBox x:Name="NumberInput" MinWidth="100"></TextBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Szczegóły wyjazdu" Width="350" Height="350" Margin="5,0,0,0">
                <StackPanel Margin="10" HorizontalAlignment="Center" Width="200">
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Label Width="70">Kierunek</Label>
                        <ComboBox x:Name="ComboList" MinWidth="100">
                            <ComboBoxItem x:Name="ComboMtn">Góry</ComboBoxItem>
                            <ComboBoxItem x:Name="ComboSea">Morze</ComboBoxItem>
                            <ComboBoxItem x:Name="ComboLake">Jeziora</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Label Width="70">Liczba dni</Label>
                        <TextBox x:Name="DaysInput" MinWidth="100"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10">
                        <CheckBox x:Name="Food" Margin="10">Pełne wyżywienie</CheckBox>
                        <CheckBox x:Name="Guide" Margin="10">Prywtny przewodnik</CheckBox>
                    </StackPanel>
                    <Button Click="DisplayTotal" Width="100" Height="30" Background="SaddleBrown" Foreground="White">Wyceń</Button>
                </StackPanel>
            </GroupBox>
        </StackPanel>
       
        <StackPanel>
            <Button Click="DisplayAll" Width="200" Height="50" FontSize="20" Background="SaddleBrown" Foreground="White">rezerwuj</Button>
        </StackPanel>
    </StackPanel>
</Window>
