<Window x:Class="paszporty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:paszporty"
        mc:Ignorable="d"
        Background="CadetBlue"
        Title="Wprowadzenie danych do paszportu. Wykonał: 00000000000" Height="450" Width="800">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" Width="350" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Width="100">Numer</Label>
                <TextBox Width="250" x:Name="NumberInput" LostFocus="NumberLostFocus"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Width="100">Imię </Label>
                <TextBox Width="250" x:Name="first_nameInput"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Width="100">Nazwisko</Label>
                <TextBox Width="250" x:Name="surnameInput"></TextBox>
            </StackPanel>
            <GroupBox Margin="0,40,0,0" Padding="0,10,0,0" Header="Kolor oczu">
                <StackPanel>
                    <RadioButton Margin="10" IsChecked="True" x:Name="blue_eyes">niebieskie</RadioButton>
                    <RadioButton Margin="10" x:Name="green_eyes">zielone</RadioButton>
                    <RadioButton Margin="10" x:Name="hazel_eyes">piwne</RadioButton>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel Orientation="Vertical" Width="350" VerticalAlignment="Center" Margin="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,50">
                <Image Source="/src/000-zdjecie.jpg" Height="180" Margin="15" x:Name="face"/>
                <Image Source="/src/000-odcisk.jpg" Height="180"  Margin="15" x:Name="fingerprint"/>
            </StackPanel>
            <Button Background="Azure" Height="35" Width="180" Click="DisplayInfo">OK</Button>
        </StackPanel>

    </StackPanel>
</Window>
